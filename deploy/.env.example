# === 🔴 Required — املأها كلها ===
DATABASE_URL="postgresql://user:pass@host:5432/fatoora?schema=public"
AUTH_SECRET="<gen: openssl rand -base64 32>"
NEXTAUTH_SECRET="<gen: openssl rand -base64 32>"
NEXTAUTH_URL="https://<your-app>.onrender.com"
ENCRYPTION_KEY="<gen: openssl rand -hex 32>"

# === 💳 Moyasar (مدى / بطاقة ائتمان / Apple Pay) ===
# سجّل في https://moyasar.com
MOYASAR_SECRET_KEY=""
MOYASAR_PUBLISHABLE_KEY=""

# === 💸 Tamara (تقسيط) ===
# سجّل في https://tamara.co
TAMARA_API_TOKEN=""
TAMARA_NOTIFICATION_TOKEN=""
TAMARA_PUBLIC_KEY=""
TAMARA_ENVIRONMENT="sandbox"

# === 📧 Email (اختياري — يستخدم لـ "نسيت كلمة المرور") ===
# سجّل في https://resend.com
RESEND_API_KEY=""
EMAIL_FROM="noreply@fatoora.sa"

# === 📱 WhatsApp (اختياري — إرسال الفواتير) ===
WHATSAPP_API_KEY=""
WHATSAPP_PHONE_ID=""
WHATSAPP_VERIFY_TOKEN=""

# === 🏦 Stripe (اختياري — بديل للمدفوعات) ===
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# === 🧪 ZATCA Tax API (اختياري) ===
AVTAX_API_KEY=""
AVTAX_API_URL="https://api.avtax.com/v1"

# === 🚀 App ===
NEXT_PUBLIC_APP_URL="https://<your-app>.onrender.com"
SEED_PASSWORD="admin123"
