# === Required ===
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fatoora?schema=public"
AUTH_SECRET="change-me-to-a-random-base64-string"
NEXTAUTH_SECRET="change-me-to-a-random-base64-string"
NEXTAUTH_URL="http://localhost:3000"
ENCRYPTION_KEY="change-me-to-a-64-char-hex-string"

# === Docker Compose ===
POSTGRES_PASSWORD="postgres"

# === Optional — leave empty to disable ===
AVTAX_API_KEY=""
AVTAX_API_URL="https://api.avtax.com/v1"
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
WHATSAPP_API_KEY=""
WHATSAPP_PHONE_ID=""
WHATSAPP_VERIFY_TOKEN=""
RESEND_API_KEY=""
EMAIL_FROM="noreply@fatoora.sa"
REDIS_URL=""

# === Moyasar (Saudi Payment Gateway — Mada, Apple Pay, STC Pay) ===
# Get keys at https://moyasar.com
MOYASAR_SECRET_KEY=""
MOYASAR_PUBLISHABLE_KEY=""

# === Tamara (BNPL — Buy Now Pay Later) ===
# Get keys at https://tamara.co
TAMARA_API_TOKEN=""
TAMARA_NOTIFICATION_TOKEN=""
TAMARA_PUBLIC_KEY=""
TAMARA_ENVIRONMENT="sandbox"

# === Seed (optional, random password generated if empty) ===
SEED_PASSWORD=""

# === App ===
NEXT_PUBLIC_APP_URL="http://localhost:3000"
