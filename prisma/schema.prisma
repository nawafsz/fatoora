generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum InvoiceType {
  CASH
  CREDIT
}

enum InvoiceStatus {
  DRAFT
  SUBMITTED
  COMPLETED
  CANCELLED
  REPORTED
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  phone         String    @unique
  passwordHash  String
  companyName   String?
  taxNumber     String?
  commercialReg String?
  city          String?
  plan          String    @default("free")
  role          String    @default("user")
  invoicesLimit Int       @default(5)
  emailVerified  Boolean   @default(false)
  phoneVerified   Boolean   @default(false)
  resetToken     String?
  resetTokenExpires DateTime?
  totpSecret    String?
  totpEnabled   Boolean   @default(false)
  loginAttempts Int       @default(0)
  lockedUntil   DateTime?
  deletedAt     DateTime?
  active        Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  clients    Client[]
  invoices   Invoice[]
  settings   Settings?
  zatcaConfig ZatcaConfig?
  auditLogs  AuditLog[]
  subscriptions Subscription[]
  payments       Payment[]
  tickets        Ticket[]
}

model Subscription {
  id                  String    @id @default(cuid())
  userId              String
  plan                String    @default("free")
  status              String    @default("incomplete")
  moyasarSubscriptionId String?
  moyasarCustomerId    String?
  currentPeriodStart  DateTime?
  currentPeriodEnd    DateTime?
  canceledAt          DateTime?
  trialEndsAt         DateTime?
  paymentMethod       String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@index([userId])
  @@index([status])
  @@index([moyasarSubscriptionId])
}

model Payment {
  id               String   @id @default(cuid())
  userId           String
  subscriptionId   String?
  amount           Decimal  @db.Decimal(10, 2)
  currency         String   @default("SAR")
  status           String   @default("pending")
  provider         String   @default("moyasar")
  providerPaymentId String?
  providerReference String?
  plan             String?
  description      String?
  createdAt        DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([providerPaymentId])
  @@index([subscriptionId])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  resource   String
  resourceId String?
  details    Json?
  ip         String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model IpBan {
  id        String   @id @default(cuid())
  ip        String   @unique
  reason    String?
  createdAt DateTime @default(now())
  expiresAt DateTime?

  @@index([ip])
  @@index([expiresAt])
}

model Client {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  email     String?
  taxNumber String?
  address   String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoices Invoice[]
}

model Invoice {
  id             String        @id @default(cuid())
  invoiceNumber  String
  type           InvoiceType   @default(CASH)
  status         InvoiceStatus @default(DRAFT)
  date           DateTime      @default(now())
  dueDate        DateTime?
  items          Json
  subtotal       Decimal       @db.Decimal(10, 2)
  discount       Decimal       @default(0) @db.Decimal(10, 2)
  taxAmount      Decimal       @db.Decimal(10, 2)
  total          Decimal       @db.Decimal(10, 2)
  notes          String?
  qrCode         String?
  pdfUrl         String?
  xmlUuid        String?
  zatcaStatus    String?
  zatcaResponse  Json?
  userId         String
  clientId       String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  client Client @relation(fields: [clientId], references: [id])

  @@index([userId])
  @@index([clientId])
  @@index([invoiceNumber])
}

model Settings {
  id            String @id @default(cuid())
  defaultTaxRate Decimal @default(15) @db.Decimal(4, 2)
  invoicePrefix String @default("INV-")
  nextNumber    Int     @default(1)
  currency      String @default("SAR")
  language      String @default("ar")
  userId        String @unique
  user          User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ZatcaConfig {
  id              String @id @default(cuid())
  environment     String @default("sandbox")
  complianceStatus String @default("pending")
  lastSyncAt      DateTime?
  userId          String @unique
  user            User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Ticket {
  id        String   @id @default(cuid())
  subject   String
  body      String
  status    String   @default("open")
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}
